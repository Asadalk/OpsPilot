DATABASE_URL=postgresql://opspilot:opspilot@localhost:5433/opspilot
# LLM provider: groq (default), gemini, or mock (offline and deterministic; no key needed).
LLM_PROVIDER=groq
# With LLM_PROVIDER=mock: normal, timeout, malformed, or unavailable (failure injection).
MOCK_LLM_MODE=normal
# Client-side pacing to your plan's tokens-per-minute limit (free tier 8000); 0 disables.
GROQ_TOKENS_PER_MINUTE=8000
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25
# Only needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_TIMEOUT_SECONDS=25
TOOL_TIMEOUT_SECONDS=5
RETRIEVAL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=5000
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
JWT_SECRET=change-this-development-secret
JWT_EXPIRE_MINUTES=60
AUTH_USERS_JSON={"viewer":{"password":"viewer","role":"viewer"},"operator":{"password":"operator","role":"operator"},"admin":{"password":"admin","role":"admin"}}
